FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      extrudeMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

constructFrom surface;

exposedPatchName movingWall;

surface "pipe.stl";

flipNormals false;

extrudeModel    twistedLinearNormal;

mergeFaces false;

mergeTol 0;

nLayers             30;

expansionRatio      1.0;

twistedLinearNormalCoeffs
{
    point (0 0 0); //Point of surfaceNormal axis
    thickness 0.005;
    totalTwist 180;
}

